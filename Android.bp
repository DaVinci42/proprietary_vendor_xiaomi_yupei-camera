android_app_import {
    name: "MiuiCamera",
    apk: "proprietary/product/priv-app/MiuiCamera/MiuiCamera.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    overrides: [
        "Aperture",
        "ApertureLensLauncher",
        "Camera2",
    ],
    dex_preopt: {
        enabled: false,
    },
    enforce_uses_libs: false,
}
